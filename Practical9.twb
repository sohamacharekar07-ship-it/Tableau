      <aliases enabled='yes' />
      <column caption='Physics_Clean' datatype='real' name='[Calculation_0772722270785536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_Clean' datatype='real' name='[Calculation_0772722271059969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Maths_Clean' datatype='integer' name='[Calculation_0772722271268866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean' datatype='integer' name='[Calculation_0772722271387651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry], 0)' />
      </column>
      <column caption='Clean_Score' datatype='real' name='[Calculation_0772722273013764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Pivot Field Values]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_0772722275532805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_0772722276802566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0772722271268866] + [Calculation_0772722270785536] + [Calculation_0772722271387651] +&#13;&#10;[Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' default-format='p0.0%' name='[Calculation_0772722277412871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0772722276802566] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_0772722277773320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0772722277412871] &gt;= 0.85 THEN &quot;Distinction&quot;&#13;&#10;ELSEIF [Calculation_0772722277412871] &gt;= 0.75 THEN &quot;First Class&quot;&#13;&#10;ELSEIF [Calculation_0772722277412871] &gt;= 0.60 THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot;&#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_0772722277957641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0772722271059969] &gt;= 75 THEN &quot;Eligible (Good Standing)&quot;&#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_0772722278621194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_0772722277412871]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' default-format='p0.0%' name='[Calculation_0772722278932491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_0772722277412871]) }' />
      </column>
      <column caption='variance_From_Dept_Average' datatype='real' default-format='p0.0%' name='[Calculation_0772722279264268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0772722277412871] - [Calculation_0772722278621194]' />
      </column>
      <column caption='Benchmark_Status' datatype='string' name='[Calculation_0772722279477261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0772722279264268] &gt;= 0 THEN &quot;Above Department&#13;&#10;Benchmark&quot;&#13;&#10;ELSE &quot;Below Department Benchmark&quot;&#13;&#10;END' />
      </column>
      <column caption='Full_Name_Clean' datatype='string' name='[Calculation_0772722280189966]' role='dimension' type='nominal'>
