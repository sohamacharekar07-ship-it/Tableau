      <aliases enabled='yes' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_0531924930322432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Total Revenue Before Discount' datatype='real' name='[Calculation_0531924931096577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]*[Quantity]' />
      </column>
      <column caption='Aggregate Profit Margin' datatype='real' name='[Calculation_0531924931686402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_0531924932329475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[State]:SUM([Sales])}' />
      </column>
      <column caption='Include Sales Per Customer' datatype='real' name='[Calculation_0531924935299081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE[Customer ID]:SUM([Sales])}' />
      </column>
      <column aggregation='Attribute' caption='Exclude Category Sales' datatype='real' name='[Calculation_0531924936208394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE[Sub-Category]:SUM([Sales])}' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_0531924937375756]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 0531924936917003] THEN &quot;Target Achieved&quot; &#13;&#10;ELSE&quot;Below Target&quot;&#13;&#10;END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_0531924939902989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount],0)' />
      </column>
      <column caption='Standardized City Type' datatype='string' name='[Calculation_0531924940230670]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City Type])' />
      </column>
      <column datatype='string' name='[City Type]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
