      <aliases enabled='yes' />
      <column caption='Votes (RUNNINF_SUM)' datatype='integer' name='[Calculation_1371677259452418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restaurant_Rank' datatype='integer' name='[Calculation_1371677260722179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Avrage Cost' datatype='real' name='[Calculation_1371677261631492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference from Window Sum' datatype='real' name='[Calculation_1371677262659590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Title' datatype='string' name='[Calculation_1371677264420874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top&quot; + STR([Parameters].[Parameter 1371677263986696]) + &quot;Restaurants by Total Votes&quot;' />
      </column>
